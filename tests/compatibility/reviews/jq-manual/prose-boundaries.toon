  audit.types.numeric-arithmetic-projection,jq-manual/types-and-values.md,20,prose-boundary,"[9007199254740993 + 0, 1.000 + 0] | map(tojson)","null",new,Arithmetic uses binary64 rather than literal provenance,manual.audit.types.numeric-arithmetic-projection
