  types.fence-001,52,fenced,"{foo: .bar}","{\"bar\":42,\"baz\":43}",new,Exact runnable fenced query; input is the prose fixture immediately following the block.,manual.types.fence-object-field
  types.fence-002,58,fenced,"{user: .user, title: .title}","{\"user\":\"stedolan\",\"title\":\"JQ Primer\",\"id\":1,\"content\":\"example\"}",adapted,Exact runnable query; representative object fixture synthesized from the prose-required user/title/id/content fields.,manual.types.fence-object-selection
  types.fence-008,97,fenced,"\"f o o\" as $foo | \"b a r\" as $bar | {$foo, $bar:$foo}","null",new,Exact runnable variable-key query; the input is irrelevant and represented as null. tq uses an equivalent static-key spelling because its object-key parser does not accept the jq shorthand form.,manual.types.fence-variable-key
  types.inline-001,18,inline,"42","null",new,Runnable literal-value example; null is a representative input because the filter ignores input.,manual.types.inline-literal-number
  types.inline-002,24,inline,"[]","null",new,Runnable empty-array constructor example; null is a representative input.,manual.types.inline-empty-array
  types.inline-003,26,inline,"[1,2,3]","null",new,Runnable array literal example; null is a representative input.,manual.types.inline-array-literal
  types.inline-005,26,inline,"[.foo, .bar, .baz]","{\"foo\":1,\"bar\":2,\"baz\":3}",adapted,Exact runnable query; representative object fixture synthesized because the prose names fields without giving a concrete input.,manual.types.inline-array-fields
  types.inline-006,26,inline,"[.items[].name]","{\"items\":[{\"name\":\"alpha\"},{\"name\":\"beta\"}]}",adapted,Exact runnable query; representative nested-items fixture synthesized because the prose names the shape without giving values.,manual.types.inline-array-names
  types.inline-009,44,inline,"{}","null",new,Runnable empty-object constructor syntax; null is a representative input.,manual.types.inline-empty-object
  types.inline-011,46,inline,"{\"a\": 42, \"b\": 17}","null",new,Runnable JSON object literal example; null is a representative input.,manual.types.inline-object-literal
  types.inline-012,48,inline,"{a:42, b:17}","null",new,Runnable identifier-like-key object example; null is a representative input.,manual.types.inline-object-identifier-keys
  types.inline-013,48,inline,"{(\"a\"+\"b\"):59}","null",new,Runnable parenthesized key-expression example; null is a representative input.,manual.types.inline-object-expression-key
  types.inline-014,62,inline,"{user, title}","{\"user\":\"stedolan\",\"title\":\"JQ Primer\",\"id\":1,\"content\":\"example\"}",adapted,Exact runnable shortcut query; representative object fixture synthesized from the prose-described fields.,manual.types.inline-object-shorthand
  types.inline-015,120,inline,..,"{\"a\":[1]}",adapted,Runnable recursive-descent expression; representative nested object fixture synthesized because no concrete input is supplied.,manual.types.inline-recursive-descent
  types.inline-016,122,inline,.,"{\"a\":1}",adapted,Runnable current-value filter mentioned in the recursive-descent prose; representative object fixture synthesized.,manual.types.inline-current-value
  types.inline-017,122,inline,recurse,"{\"a\":1}",adapted,Runnable zero-argument recurse example; representative object fixture synthesized from the prose description.,manual.types.inline-recurse-builtin
  types.inline-018,122,inline,..a,"[[{\"a\":1}]]",new,Documented negative syntax example; exact query is retained as a required compile-error test.,manual.types.inline-invalid-recursive
  types.inline-019,122,inline,.. | .a,"null",adapted,Runnable replacement expression; null is a representative input because the prose gives no concrete fixture.,manual.types.inline-recursive-pipe
