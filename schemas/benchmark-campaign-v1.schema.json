{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tq.dev/schemas/benchmark-campaign-v1.schema.json",
  "title": "tq benchmark campaign report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "profile", "environment", "corpus", "tools", "cases", "comparability", "regression_gate", "final_status"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["smoke", "rapid", "standard", "large"]},
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["collected_at", "os", "kernel", "architecture", "logical_cpus", "physical_cpus", "cpu_model", "memory_bytes", "filesystem", "power_settings", "compiler_profile"]
    },
    "corpus": {"type": "array"},
    "tools": {"type": "array"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "diagnostic": {"type": "string", "maxLength": 1024},
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
                "process_group_peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
                "rss_provenance": {
                  "anyOf": [
                    {"enum": ["gnu-time-v", "bsd-time-l"]},
                    {"type": "null"}
                  ]
                }
              }
            }
          }
        }
      }
    },
    "comparability": {"type": "object"},
    "regression_gate": {"type": "object"},
    "final_status": {"enum": ["passed", "observed-failures", "regression"]}
  }
}
